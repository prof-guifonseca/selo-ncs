# =============================================================================
# Selo NCS — .env (LOCAL ONLY)
# NUNCA commitar este arquivo com chaves reais.
# Use .env.example para versionar o template.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (server-side)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=SEU_ANON_KEY

# Storage bucket (opcional; default no código: ncs-evidences)
SUPABASE_BUCKET=ncs-evidences

# -----------------------------------------------------------------------------
# Auth / Gates
# -----------------------------------------------------------------------------
# Produção recomendada: 1 (fail-safe)
# Local/pitch: 0 (não exige auth em rotas sensíveis)
NCS_REQUIRE_AUTH=1

# RLS-only (fail-fast guard — não é toggle)
# - NCS_USE_RLS em 0/false/no -> API responde 503 (MISCONFIG_RLS_DISABLED)
# - NCS_USE_RLS em 1 (ou omitido) -> ok
NCS_USE_RLS=1

# Rate limit simples do /auth/login (hits/min por IP+email)
NCS_LOGIN_RATE_LIMIT=8

# CORS: para cookie-first, prefira origem explícita (separar por ambiente)
# Ex.: http://localhost:8888  (Netlify dev) ou http://localhost:5173 (vite)
# IMPORTANTE: sem barra final (use https://site.com e não https://site.com/)
# Dica: você pode separar múltiplas origens por vírgula.
NCS_CORS_ORIGIN=http://localhost:8888

# Cookie HttpOnly (fonte de verdade da sessão)
# - Em produção (Netlify), o padrão é Secure=1.
# - Em dev local em HTTP, defina NCS_COOKIE_SECURE=0 (cookies Secure não funcionam em http://).

# - SameSite: quando a SPA e /api estiverem em origens diferentes, use "None" (requer HTTPS).
#   Quando for mesma origem, "Lax" é suficiente.
#
# Exemplo explícito (cross-site):
# NCS_COOKIE_SAMESITE=None
# NCS_COOKIE_SECURE=1
#
# Tempo de vida do refresh cookie (segundos). Default: 30 dias.
NCS_REFRESH_COOKIE_MAX_AGE=2592000

# -----------------------------------------------------------------------------
# Chat (opcional)
# -----------------------------------------------------------------------------
# Chave da OpenAI para habilitar o chat IA.  Quando ausente, o fallback
# heurístico local é usado em `netlify/functions/chat.js`.
OPENAI_API_KEY=SEU_OPENAI_API_KEY

# Flag de IA (0/1).  Quando 0 (padrão) a IA fica desativada, mesmo se a chave estiver presente.
NCS_AI_ENABLED=0

# -----------------------------------------------------------------------------
# Cookies (opcional)
# -----------------------------------------------------------------------------
# SameSite controla como os cookies são enviados em requisições cross‑site.
# Valores aceitos: Lax, Strict ou None.  Quando vazio, o backend escolhe
# automaticamente: Lax para mesma origem e None para origens diferentes.
NCS_COOKIE_SAMESITE=

# Força a flag Secure nos cookies.  Use 1 em produção (HTTPS) e 0 em
# desenvolvimento local (HTTP).  Quando NCS_COOKIE_SAMESITE=None, o backend
# aplica Secure automaticamente.
NCS_COOKIE_SECURE=
